@page
@model ZevEbixWeb.Pages.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-start mb-3 gap-3 flex-wrap">
    <div>
        <h2 class="h4 mb-1">Liegenschaft Dashboard</h2>
        <form method="post" asp-page="/Logout">
            @Html.AntiForgeryToken()
            <button class="btn btn-outline-secondary btn-sm" type="submit">Abmelden</button>
        </form>
    </div>

    <div class="card">
        <div class="card-body py-2 px-3">
            <h6 class="card-title mb-2">PV Produktion (Live)</h6>
            @if (Model.AllPropertyProductionRows.Count == 0)
            {
                <div class="text-muted small">Keine Live-Entitäten konfiguriert.</div>
            }
            else
            {
                <div class="small">
                    @foreach (var row in Model.AllPropertyProductionRows)
                    {
                        <div class="d-flex justify-content-between gap-3">
                            <span>@row.PropertyName</span>
                            <span class="fw-semibold">@row.LiveKw.ToString("N1") kW</span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-warning">@Model.ErrorMessage</div>
}

@if (Model.MonthRows.Count > 0)
{
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Monatsübersicht</h5>
            <div class="table-responsive">
                <table class="table table-sm table-striped">
                    <thead>
                    <tr>
                        <th>Monat</th>
                        <th>Verbrauch (kWh)</th>
                        <th>Netz (kWh)</th>
                        <th>PV Bezug (kWh)</th>
                        <th>PV Produktion (kWh)</th>
                        <th>Kosten (CHF)</th>
                        <th>Ersparnis PV (CHF)</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in Model.MonthRows)
                    {
                        <tr>
                            <td>@row.MonthLabel</td>
                            <td>@row.TotalKwh.ToString("N3")</td>
                            <td>@row.GridKwh.ToString("N3")</td>
                            <td>@row.PvKwh.ToString("N3")</td>
                            <td>@row.FeedInKwh.ToString("N3")</td>
                            <td>@row.TotalCost.ToString("N2")</td>
                            <td>@row.SavedByNeighborPv.ToString("N2")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">Tagesverbrauch</h5>

        <form method="get" class="row g-2 align-items-end mb-3">
            @if (User.IsInRole("admin"))
            {
                <div class="col-md-3">
                    <label class="form-label">Liegenschaft</label>
                    <select class="form-select" name="property" onchange="this.form.submit()">
                        @foreach (var property in Model.AvailableProperties)
                        {
                            <option value="@property" selected="@(string.Equals(property, Model.PropertyName, StringComparison.OrdinalIgnoreCase))">@property</option>
                        }
                    </select>
                </div>
            }

            <div class="col-md-2">
                <label class="form-label">Filter</label>
                <select class="form-select" name="mode" onchange="this.form.submit()">
                    <option value="day" selected="@(Model.Mode == "day")">Tag</option>
                    <option value="week" selected="@(Model.Mode == "week")">Woche</option>
                    <option value="month" selected="@(Model.Mode == "month")">Monat</option>
                    <option value="year" selected="@(Model.Mode == "year")">Jahr</option>
                </select>
            </div>

            @if (Model.Mode == "day")
            {
                <div class="col-md-1 d-grid">
                    <label class="form-label d-none d-md-block">&nbsp;</label>
                    <a class="btn btn-outline-secondary btn-sm" asp-page="/Dashboard" asp-route-property="@Model.PropertyName" asp-route-mode="day" asp-route-day="@Model.PrevDay.ToString("yyyy-MM-dd")">&lt;</a>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Tag</label>
                    <input class="form-control" type="date" name="day" value="@Model.SelectedDay.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
                </div>
                <div class="col-md-1 d-grid">
                    <label class="form-label d-none d-md-block">&nbsp;</label>
                    <a class="btn btn-outline-secondary btn-sm" asp-page="/Dashboard" asp-route-property="@Model.PropertyName" asp-route-mode="day" asp-route-day="@Model.NextDay.ToString("yyyy-MM-dd")">&gt;</a>
                </div>
            }
            else if (Model.Mode == "week")
            {
                <div class="col-md-3">
                    <label class="form-label">Woche</label>
                    <input class="form-control" type="week" name="weekValue" value="@Model.SelectedWeekValue" onchange="this.form.submit()" />
                </div>
                <div class="col-md-1 d-grid">
                    <a class="btn btn-outline-secondary btn-sm" asp-page="/Dashboard" asp-route-property="@Model.PropertyName" asp-route-mode="week" asp-route-year="@Model.PrevWeekYear" asp-route-week="@Model.PrevWeek">&lt;</a>
                </div>
                <div class="col-md-1 d-grid">
                    <a class="btn btn-outline-secondary btn-sm" asp-page="/Dashboard" asp-route-property="@Model.PropertyName" asp-route-mode="week" asp-route-year="@Model.NextWeekYear" asp-route-week="@Model.NextWeek">&gt;</a>
                </div>
            }
            else if (Model.Mode == "month")
            {
                <div class="col-md-2">
                    <label class="form-label">Jahr</label>
                    <input class="form-control" type="number" name="year" value="@Model.SelectedYear" onchange="this.form.submit()" />
                </div>
                <div class="col-md-1 d-grid">
                    <button class="btn btn-outline-secondary btn-sm" type="submit" name="year" value="@(Model.SelectedYear - 1)">&lt;</button>
                </div>
                <div class="col-md-1 d-grid">
                    <button class="btn btn-outline-secondary btn-sm" type="submit" name="year" value="@(Model.SelectedYear + 1)">&gt;</button>
                </div>
            }

        </form>

        <div style="height: 280px;" class="mb-3">
            <canvas id="consumptionChart"></canvas>
        </div>

        <div class="table-responsive">
            <table class="table table-sm table-hover">
                <thead>
                <tr>
                    <th>Periode</th>
                    <th class="text-end">Netz kWh</th>
                    <th class="text-end">PV kWh</th>
                    <th class="text-end">Total kWh</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var point in Model.ConsumptionPoints)
                {
                    <tr>
                        <td>@point.Label</td>
                        <td class="text-end">@point.GridKwh.ToString("N3")</td>
                        <td class="text-end">@point.PvKwh.ToString("N3")</td>
                        <td class="text-end">@point.TotalKwh.ToString("N3")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        (() => {
            const labels = [@Html.Raw(string.Join(",", Model.ConsumptionPoints.Select(x => $"\"{x.Label}\"")))];
            const grid = [@Html.Raw(string.Join(",", Model.ConsumptionPoints.Select(x => x.GridKwh.ToString(System.Globalization.CultureInfo.InvariantCulture))))];
            const pv = [@Html.Raw(string.Join(",", Model.ConsumptionPoints.Select(x => x.PvKwh.ToString(System.Globalization.CultureInfo.InvariantCulture))))];

            const canvas = document.getElementById('consumptionChart');
            if (!canvas) return;

            new Chart(canvas, {
                type: 'bar',
                data: {
                    labels,
                    datasets: [
                        { label: 'Netz kWh', data: grid, backgroundColor: '#0d6efd' },
                        { label: 'PV kWh', data: pv, backgroundColor: '#198754' }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        x: { stacked: true },
                        y: { stacked: true, beginAtZero: true }
                    }
                }
            });
        })();
    </script>
}
