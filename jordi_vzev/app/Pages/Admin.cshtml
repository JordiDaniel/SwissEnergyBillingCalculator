@page
@model ZevEbixWeb.Pages.AdminModel
@{
    ViewData["Title"] = "Admin";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 mb-0">Jordi.vzev Admin</h2>
    <form method="post" asp-page="/Logout">
        @Html.AntiForgeryToken()
        <button class="btn btn-outline-secondary btn-sm" type="submit">Abmelden</button>
    </form>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-info">@Model.Message</div>
}

<form method="post" class="border rounded p-3 mb-3">
    @Html.AntiForgeryToken()
    <h5>Allgemein</h5>
    <div class="row g-2 mb-3">
        <div class="col-md-6">
            <label class="form-label">CSV-Dateiordner</label>
            <input class="form-control" name="DataSource" value="@Model.DataSource" placeholder="/share/vzev" />
        </div>
        <div class="col-md-3">
            <label class="form-label">PV-Verteilung</label>
            <select class="form-select" name="PvDistributionMode">
                <option value="FairShare" selected="@(Model.PvDistributionMode != "Priority")">Gleichmässig</option>
                <option value="Priority" selected="@(Model.PvDistributionMode == "Priority")">Priorität</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">ZEV Bezug-Zähler</label>
            <select class="form-select" name="ZevImportMeterId">
                <option value=""></option>
                @foreach (var meter in Model.AvailableMeters)
                {
                    <option value="@meter" selected="@(string.Equals(meter, Model.ZevImportMeterId, StringComparison.OrdinalIgnoreCase))">@meter</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">ZEV Rücklieferung-Zähler</label>
            <select class="form-select" name="ZevExportMeterId">
                <option value=""></option>
                @foreach (var meter in Model.AvailableMeters)
                {
                    <option value="@meter" selected="@(string.Equals(meter, Model.ZevExportMeterId, StringComparison.OrdinalIgnoreCase))">@meter</option>
                }
            </select>
        </div>
    </div>

    <h6>Liegenschaften</h6>
    <table class="table table-sm table-bordered">
        <thead>
        <tr>
            <th>Name</th>
            <th>Netz-Zähler</th>
            <th>PV-Zähler</th>
            <th>HA Entität Produktion</th>
            <th>Priorität</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @for (var i = 0; i < Model.PropertyMappings.Count; i++)
        {
            <tr>
                <td><input class="form-control" name="PropertyMappings[@i].PropertyName" value="@Model.PropertyMappings[i].PropertyName" /></td>
                <td>
                    <select class="form-select" name="PropertyMappings[@i].GridMeterId">
                        <option value=""></option>
                        @foreach (var meter in Model.AvailableMeters)
                        {
                            <option value="@meter" selected="@(string.Equals(meter, Model.PropertyMappings[i].GridMeterId, StringComparison.OrdinalIgnoreCase))">@meter</option>
                        }
                    </select>
                </td>
                <td>
                    <select class="form-select" name="PropertyMappings[@i].PvMeterId">
                        <option value=""></option>
                        @foreach (var meter in Model.AvailableMeters)
                        {
                            <option value="@meter" selected="@(string.Equals(meter, Model.PropertyMappings[i].PvMeterId, StringComparison.OrdinalIgnoreCase))">@meter</option>
                        }
                    </select>
                </td>
                <td><input class="form-control" name="PropertyMappings[@i].CurrentProductionEntityId" value="@Model.PropertyMappings[i].CurrentProductionEntityId" placeholder="sensor.active_power" /></td>
                <td><input class="form-control" name="PropertyMappings[@i].PvPriority" value="@Model.PropertyMappings[i].PvPriority" /></td>
                <td>
                    <button class="btn btn-outline-danger btn-sm" type="submit" name="removePropertyIndex" value="@i">X</button>
                </td>
            </tr>
        }
        </tbody>
    </table>
    <button class="btn btn-outline-secondary btn-sm" type="submit" name="command" value="AddProperty">Liegenschaft hinzufügen</button>

    <h6 class="mt-3">Monatliche Preise</h6>
    <table class="table table-sm table-bordered">
        <thead>
        <tr>
            <th>Monat (yyyy-MM)</th>
            <th>Netzpreis</th>
            <th>PV-Preis</th>
            <th>Einspeisepreis</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @for (var i = 0; i < Model.MonthlyPrices.Count; i++)
        {
            <tr>
                <td><input class="form-control" name="MonthlyPrices[@i].MonthKey" value="@Model.MonthlyPrices[i].MonthKey" /></td>
                <td><input class="form-control" name="MonthlyPrices[@i].GridPricePerKwh" value="@Model.MonthlyPrices[i].GridPricePerKwh" /></td>
                <td><input class="form-control" name="MonthlyPrices[@i].PvPricePerKwh" value="@Model.MonthlyPrices[i].PvPricePerKwh" /></td>
                <td><input class="form-control" name="MonthlyPrices[@i].FeedInTariffPerKwh" value="@Model.MonthlyPrices[i].FeedInTariffPerKwh" /></td>
                <td>
                    <button class="btn btn-outline-danger btn-sm" type="submit" name="removePriceIndex" value="@i">X</button>
                </td>
            </tr>
        }
        </tbody>
    </table>

    <div class="d-flex gap-2">
        <button class="btn btn-outline-secondary btn-sm" type="submit" name="command" value="AddPrice">Preiszeile hinzufügen</button>
        <button class="btn btn-success" type="submit" name="command" value="Save">Speichern</button>
        <button class="btn btn-primary" type="submit" name="command" value="Reload">Daten laden</button>
    </div>
</form>
