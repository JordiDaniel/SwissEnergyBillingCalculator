@page
@model ZevEbixWeb.Pages.PublicModel
@{
    ViewData["Title"] = "Stromauswertung";
}

<h2>Stromauswertung</h2>
<div class="mb-3"><strong>Status:</strong> @Model.StatusText</div>

<div class="table-responsive">
    <table class="table table-striped table-sm">
        <thead>
        <tr>
            <th>Monat</th>
            <th>Liegenschaft</th>
            <th>Total kWh</th>
            <th>Netz kWh</th>
            <th>PV kWh</th>
            <th>Einspeisung kWh</th>
            <th>ZEV Bezug kWh</th>
            <th>ZEV Rücklieferung kWh</th>
            <th>Netz CHF</th>
            <th>PV CHF</th>
            <th>PV Erlös CHF</th>
            <th>Saldo CHF</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var row in Model.SummaryRows)
        {
            <tr>
                <td>@row.MonthLabel</td>
                <td>@row.PropertyName</td>
                <td>@row.TotalKwh.ToString("N3")</td>
                <td>@row.GridKwh.ToString("N3")</td>
                <td>@row.PvKwh.ToString("N3")</td>
                <td>@row.FeedInKwh.ToString("N3")</td>
                <td>@row.ZevImportKwh.ToString("N3")</td>
                <td>@row.ZevExportKwh.ToString("N3")</td>
                <td>@row.GridCost.ToString("N2")</td>
                <td>@row.PvCost.ToString("N2")</td>
                <td>@row.PvRevenue.ToString("N2")</td>
                <td>@row.TotalCost.ToString("N2")</td>
            </tr>
        }
        </tbody>
    </table>
</div>
