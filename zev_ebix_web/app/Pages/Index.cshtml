@page
@model IndexModel
@{
    ViewData["Title"] = "ZEV Abrechnung";
}

<h2>ZEV Abrechnung (Web)</h2>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@error.ErrorMessage</div>
        }
    </div>
}

@if (Model.Warnings.Count > 0)
{
    <div class="alert alert-warning">
        @foreach (var warning in Model.Warnings)
        {
            <div>@warning</div>
        }
    </div>
}

<div class="mb-3"><strong>Status:</strong> @Model.StatusText</div>

<form method="post" asp-page-handler="LoadData" class="border rounded p-3 mb-3">
    <h5>Datenquelle laden</h5>
    <div class="row g-2">
        <div class="col-10">
            <input class="form-control" name="DataSource" value="@Model.DataSource" placeholder="Lokaler Pfad oder Dropbox-Link" />
        </div>
        <div class="col-2 d-grid">
            <button class="btn btn-primary" type="submit">Laden</button>
        </div>
    </div>
</form>

<form method="post" asp-page-handler="SaveConfig" class="border rounded p-3 mb-3">
    <h5>Konfiguration</h5>
    <input type="hidden" name="DataSource" value="@Model.DataSource" />

    <div class="row g-2 mb-2">
        <div class="col-md-3">
            <label class="form-label">PV-Verteilung</label>
            <select class="form-select" name="PvDistributionMode">
                <option value="FairShare" selected="@(Model.PvDistributionMode != "Priority")">Gleichmässig</option>
                <option value="Priority" selected="@(Model.PvDistributionMode == "Priority")">Priorität</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">ZEV Bezug-Zähler</label>
            <select class="form-select" name="ZevImportMeterId">
                <option value=""></option>
                @foreach (var meter in Model.AvailableMeters)
                {
                    if (string.Equals(meter, Model.ZevImportMeterId, StringComparison.OrdinalIgnoreCase))
                    {
                        <option selected value="@meter">@meter</option>
                    }
                    else
                    {
                        <option value="@meter">@meter</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">ZEV Rücklieferung-Zähler</label>
            <select class="form-select" name="ZevExportMeterId">
                <option value=""></option>
                @foreach (var meter in Model.AvailableMeters)
                {
                    if (string.Equals(meter, Model.ZevExportMeterId, StringComparison.OrdinalIgnoreCase))
                    {
                        <option selected value="@meter">@meter</option>
                    }
                    else
                    {
                        <option value="@meter">@meter</option>
                    }
                }
            </select>
        </div>
    </div>

    <h6 class="mt-3">Liegenschaften / Zähler</h6>
    <table class="table table-sm table-bordered">
        <thead>
        <tr>
            <th>Liegenschaft</th>
            <th>Netz-Zähler</th>
            <th>PV-Zähler</th>
            <th>Priorität</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @for (var i = 0; i < Model.PropertyMappings.Count; i++)
        {
            <tr>
                <td><input class="form-control" name="PropertyMappings[@i].PropertyName" value="@Model.PropertyMappings[i].PropertyName" /></td>
                <td><input class="form-control" name="PropertyMappings[@i].GridMeterId" value="@Model.PropertyMappings[i].GridMeterId" /></td>
                <td><input class="form-control" name="PropertyMappings[@i].PvMeterId" value="@Model.PropertyMappings[i].PvMeterId" /></td>
                <td><input class="form-control" name="PropertyMappings[@i].PvPriority" value="@Model.PropertyMappings[i].PvPriority" /></td>
                <td>
                    <button class="btn btn-outline-danger btn-sm" type="submit" asp-page-handler="RemoveProperty" asp-route-index="@i">X</button>
                </td>
            </tr>
        }
        </tbody>
    </table>
    <button class="btn btn-outline-secondary btn-sm" type="submit" asp-page-handler="AddProperty">Liegenschaft hinzufügen</button>

    <h6 class="mt-3">Monatliche Preise</h6>
    <table class="table table-sm table-bordered">
        <thead>
        <tr>
            <th>Monat (yyyy-MM)</th>
            <th>Netzpreis</th>
            <th>PV-Preis</th>
            <th>Einspeisevergütung</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @for (var i = 0; i < Model.MonthlyPrices.Count; i++)
        {
            <tr>
                <td><input class="form-control" name="MonthlyPrices[@i].MonthKey" value="@Model.MonthlyPrices[i].MonthKey" /></td>
                <td><input class="form-control" name="MonthlyPrices[@i].GridPricePerKwh" value="@Model.MonthlyPrices[i].GridPricePerKwh" /></td>
                <td><input class="form-control" name="MonthlyPrices[@i].PvPricePerKwh" value="@Model.MonthlyPrices[i].PvPricePerKwh" /></td>
                <td><input class="form-control" name="MonthlyPrices[@i].FeedInTariffPerKwh" value="@Model.MonthlyPrices[i].FeedInTariffPerKwh" /></td>
                <td>
                    <button class="btn btn-outline-danger btn-sm" type="submit" asp-page-handler="RemovePrice" asp-route-index="@i">X</button>
                </td>
            </tr>
        }
        </tbody>
    </table>
    <button class="btn btn-outline-secondary btn-sm" type="submit" asp-page-handler="AddPrice">Preiszeile hinzufügen</button>

    <div class="mt-3 d-grid gap-2 d-md-block">
        <button class="btn btn-success" type="submit">Konfiguration speichern & Auswertung aktualisieren</button>
    </div>
</form>

<div class="alert alert-secondary mt-3">
    Öffentliche Verbrauchsansicht ist unter <strong>/strom</strong> verfügbar.
</div>
