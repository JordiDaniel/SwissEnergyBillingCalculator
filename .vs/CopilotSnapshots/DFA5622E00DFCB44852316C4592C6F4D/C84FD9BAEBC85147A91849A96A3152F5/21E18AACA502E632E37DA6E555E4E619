    private void RefreshMonthFilter()
    {
        var months = _meterReadings
            .Select(x => x.Date.ToString("yyyy-MM", CultureInfo.InvariantCulture))
            .Distinct()
            .OrderBy(x => x)
            .ToList();

        MonthFilterComboBox.Items.Clear();
        MonthFilterComboBox.Items.Add("Alle");

        foreach (var month in months)
