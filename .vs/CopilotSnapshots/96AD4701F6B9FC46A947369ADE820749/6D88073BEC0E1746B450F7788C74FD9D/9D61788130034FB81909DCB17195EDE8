<Window x:Class="ZevEbixApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZevEbixApp"
        mc:Ignorable="d"
        Title="ZEV Abrechnung" Height="720" Width="1100">
    <Grid Margin="12">
        <TabControl>
            <TabItem Header="Abrechnung">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button Name="LoadEbixButton" Content="Datenordner laden" Width="150" Margin="0,0,8,0" Click="LoadEbixButton_OnClick" />
                        <TextBlock Name="LoadedFileText" VerticalAlignment="Center" Text="Kein Ordner geladen" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,10,0,10">
                        <TextBlock VerticalAlignment="Center" Text="Monat:" Margin="0,0,8,0" />
                        <ComboBox Name="MonthFilterComboBox" Width="160" SelectionChanged="MonthFilterComboBox_OnSelectionChanged" />
                        <Button Content="Aktualisieren" Width="120" Margin="12,0,0,0" Click="RefreshSummaryButton_OnClick" />
                        <Button Content="Export CSV" Width="120" Margin="12,0,0,0" Click="ExportCsvButton_OnClick" />
                        <Button Content="Export Excel-CSV" Width="140" Margin="8,0,0,0" Click="ExportExcelCsvButton_OnClick" />
                        <Button Content="Export PDF" Width="120" Margin="8,0,0,0" Click="ExportPdfButton_OnClick" />
                    </StackPanel>

                    <DataGrid Name="SummaryDataGrid"
                              Grid.Row="2"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              Margin="0,0,0,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Monat" Binding="{Binding MonthLabel}" Width="100" />
                            <DataGridTextColumn Header="Liegenschaft" Binding="{Binding PropertyName}" Width="220" />
                            <DataGridTextColumn Header="Verbrauch total (kWh)" Binding="{Binding TotalKwh, StringFormat=N3}" Width="*" />
                            <DataGridTextColumn Header="Netzbezug (kWh)" Binding="{Binding GridKwh, StringFormat=N3}" Width="*" />
                            <DataGridTextColumn Header="PV-Strom (kWh)" Binding="{Binding PvKwh, StringFormat=N3}" Width="*" />
                            <DataGridTextColumn Header="Netzkosten (CHF)" Binding="{Binding GridCost, StringFormat=N2}" Width="*" />
                            <DataGridTextColumn Header="PV-Kosten (CHF)" Binding="{Binding PvCost, StringFormat=N2}" Width="*" />
                            <DataGridTextColumn Header="Gesamtkosten (CHF)" Binding="{Binding TotalCost, StringFormat=N2}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Konfiguration">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock FontWeight="Bold" Text="EBIX-Datenordner" />
                    <Grid Grid.Row="1" Margin="0,8,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Name="DataFolderTextBox" Grid.Column="0" Margin="0,0,8,0" TextChanged="DataFolderTextBox_OnTextChanged" />
                        <Button Grid.Column="1" Content="Ordner auswählen" Padding="12,4" Click="BrowseDataFolderButton_OnClick" />
                    </Grid>

                    <TextBlock Grid.Row="2" FontWeight="Bold" Text="Liegenschaft und Zähler-Zuordnung" />
                    <Grid Grid.Row="3" Margin="0,8,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Name="PropertyNameTextBox" Grid.Column="0" Margin="0,0,8,0" />
                        <ComboBox Name="GridMeterComboBox" Grid.Column="1" Margin="0,0,8,0" />
                        <ComboBox Name="PvMeterComboBox" Grid.Column="2" Margin="0,0,8,0" />
                        <Button Grid.Column="3" Content="PV löschen" Padding="12,4" Margin="0,0,8,0" Click="ClearPvSelectionButton_OnClick" />
                        <Button Grid.Column="4" Content="Hinzufügen" Padding="12,4" Click="AddPropertyMappingButton_OnClick" />
                    </Grid>

                    <DataGrid Name="PropertyMappingsDataGrid"
                              Grid.Row="4"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              RowEditEnding="PropertyMappingsDataGrid_OnRowEditEnding"
                              Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Liegenschaft" Binding="{Binding PropertyName}" Width="2*" />
                            <DataGridTextColumn Header="Netz-Zähler" Binding="{Binding GridMeterId}" Width="2*" />
                            <DataGridTextColumn Header="PV-Zähler" Binding="{Binding PvMeterId}" Width="2*" />
                            <DataGridTextColumn Header="PV-Priorität" Binding="{Binding PvPriority}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Ausgewählte Liegenschaft löschen" Width="220" Click="RemovePropertyMappingButton_OnClick" />
                        <Button Content="PV-Zähler bei Auswahl entfernen" Width="240" Margin="10,0,0,0" Click="ClearSelectedPropertyPvMeterButton_OnClick" />
                        <Button Content="Konfiguration speichern" Width="180" Margin="10,0,0,0" Click="SaveConfigButton_OnClick" />
                    </StackPanel>

                    <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock VerticalAlignment="Center" Text="PV-Verteilung:" Margin="0,0,8,0" />
                        <ComboBox Name="PvDistributionModeComboBox" Width="220" SelectionChanged="PvDistributionModeComboBox_OnSelectionChanged" />
                    </StackPanel>

                    <GroupBox Grid.Row="7" Header="Monatliche Preise (CHF/kWh)">
                        <DataGrid Name="MonthlyPricesDataGrid" AutoGenerateColumns="False" CanUserAddRows="True" RowEditEnding="MonthlyPricesDataGrid_OnRowEditEnding">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Monat (yyyy-MM)" Binding="{Binding MonthKey}" Width="2*" />
                                <DataGridTextColumn Header="Netzpreis" Binding="{Binding GridPricePerKwh}" Width="*" />
                                <DataGridTextColumn Header="PV-Preis" Binding="{Binding PvPricePerKwh}" Width="*" />
                                <DataGridTextColumn Header="Einspeisevergütung" Binding="{Binding FeedInTariffPerKwh}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
