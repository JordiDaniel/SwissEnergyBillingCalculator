    private void SortMonthlyPrices()
    {
        var ordered = _monthlyPrices
            .OrderBy(x => x.MonthKey, StringComparer.Ordinal)
            .ToList();

        _monthlyPrices.Clear();
        foreach (var entry in ordered)
        {
            _monthlyPrices.Add(entry);
        }
    }

    private void LoadConfig()
    {
        _isLoadingConfig = true;

        if (!File.Exists(_configPath))
        {
            _isLoadingConfig = false;
            return;
        }

        try
        {
            var content = File.ReadAllText(_configPath);
            var config = JsonSerializer.Deserialize<AppConfig>(content);
            if (config is null)
            {
                return;
            }

            _propertyMappings.Clear();
            foreach (var mapping in config.PropertyMappings)
            {
                _propertyMappings.Add(mapping);
            }

            _monthlyPrices.Clear();
            foreach (var price in config.MonthlyPrices)
            {
                _monthlyPrices.Add(price);
            }

            _pvDistributionMode = NormalizeDistributionMode(config.PvDistributionMode);

            DataFolderTextBox.Text = config.DataFolderPath;
        }
        finally
        {
            _isLoadingConfig = false;
        }
    }

    private void SaveConfig()
    {
        var config = new AppConfig
        {
            PropertyMappings = _propertyMappings.ToList(),
            MonthlyPrices = _monthlyPrices.Where(x => !string.IsNullOrWhiteSpace(x.MonthKey)).ToList(),
            DataFolderPath = DataFolderTextBox.Text.Trim(),
            PvDistributionMode = NormalizeDistributionMode(_pvDistributionMode)
        };

        var json = JsonSerializer.Serialize(config, new JsonSerializerOptions
        {
            WriteIndented = true
        });

        File.WriteAllText(_configPath, json);
    }

    private void NormalizePropertyPriorities()
    {
        var used = new HashSet<int>();
        var next = 1;
        foreach (var mapping in _propertyMappings)
        {
            if (mapping.PvPriority <= 0 || used.Contains(mapping.PvPriority))
            {
                while (used.Contains(next))
                {
                    next++;
                }

                mapping.PvPriority = next;
            }

            used.Add(mapping.PvPriority);
        }
    }

    private int GetNextPvPriority()
    {
        return _propertyMappings.Count == 0 ? 1 : _propertyMappings.Max(x => x.PvPriority) + 1;
    }

    private void ApplyDistributionModeSelection()
    {
        var normalized = NormalizeDistributionMode(_pvDistributionMode);
        if (!Equals(PvDistributionModeComboBox.SelectedValue, normalized))
        {
            PvDistributionModeComboBox.SelectedValue = normalized;
        }

        _pvDistributionMode = normalized;
    }

    private static string NormalizeDistributionMode(string? mode)
    {
        return string.Equals(mode, PvDistributionModePriority, StringComparison.OrdinalIgnoreCase)
            ? PvDistributionModePriority
            : PvDistributionModeFair;
    }

    private void AutoSaveConfiguration(bool commitEdits = true)
    {
        if (_isLoadingConfig || _isAutoSaving)
        {
            return;
        }

        _isAutoSaving = true;
        try
        {
            if (commitEdits)
            {
                CommitPropertyMappingEdits();
                CommitMonthlyPriceEdits();
            }

            SaveConfig();
        }
        finally
        {
            _isAutoSaving = false;
        }
    }

    private void ExportCsv(char separator, CultureInfo culture, string extension, string title)
    {
        var rows = _summaryRows.ToList();
        if (rows.Count == 0)
        {
            MessageBox.Show("Keine Daten zum Exportieren vorhanden.", "Hinweis", MessageBoxButton.OK, MessageBoxImage.Information);
            return;
        }

        var dialog = new SaveFileDialog
        {
            Filter = "CSV (*.csv)|*.csv",
            DefaultExt = extension,
            FileName = BuildExportFileName(extension),
            Title = title
        };

        if (dialog.ShowDialog() != true)
        {
            return;
        }

        try
        {
            var csv = BuildCsv(rows, separator, culture);
            File.WriteAllText(dialog.FileName, csv, new UTF8Encoding(true));
            MessageBox.Show("Export erfolgreich erstellt.", "Info", MessageBoxButton.OK, MessageBoxImage.Information);
        }
        catch (Exception ex)
        {
            MessageBox.Show($"Export fehlgeschlagen: {ex.Message}", "Fehler", MessageBoxButton.OK, MessageBoxImage.Error);
        }
    }

    private string BuildExportFileName(string extension)
    {
        var month = GetSelectedMonth() ?? "alle-monate";
        return $"zev-abrechnung-{month}.{extension}";
    }

    private static string BuildCsv(IReadOnlyCollection<SummaryRow> rows, char separator, CultureInfo culture)
    {
        var sb = new StringBuilder();
        sb.AppendJoin(separator, [
            "Monat",
            "Liegenschaft",
            "Verbrauch total (kWh)",
            "Netzbezug (kWh)",
            "PV-Strom (kWh)",
            "Einspeisung (kWh)",
            "Netzkosten (CHF)",
            "PV-Kosten (CHF)",
            "Ersparnis durch Nachbar-PV (CHF)",
            "Mehrerlös vs. Einspeisung (CHF)",
            "PV-Erlös (CHF)",
            "Saldo (CHF)"]);
        sb.AppendLine();

        foreach (var row in rows)
        {
            var values = new[]
            {
                row.MonthLabel,
                row.PropertyName,
                row.TotalKwh.ToString("N3", culture),
                row.GridKwh.ToString("N3", culture),
                row.PvKwh.ToString("N3", culture),
                row.FeedInKwh.ToString("N3", culture),
                row.GridCost.ToString("N2", culture),
                row.PvCost.ToString("N2", culture),
                row.SavedByNeighborPv.ToString("N2", culture),
                row.AdditionalRevenueVsFeedIn.ToString("N2", culture),
                row.PvRevenue.ToString("N2", culture),
                row.TotalCost.ToString("N2", culture)
            };

            sb.AppendJoin(separator, values.Select(x => EscapeCsvValue(x, separator)));
            sb.AppendLine();
        }

        return sb.ToString();
    }

    private static string EscapeCsvValue(string value, char separator)
    {
        if (!value.Contains(separator) && !value.Contains('"') && !value.Contains('\n') && !value.Contains('\r'))
        {
            return value;
        }

        return $"\"{value.Replace("\"", "\"\"")}\"";
    }

    private static void WriteSimplePdf(string filePath, IReadOnlyCollection<SummaryRow> rows)
    {
        var tableLines = new List<string>
        {
            "ZEV Abrechnung (gefilterte Ansicht)",
            string.Empty,
            "Monat | Liegenschaft | Total kWh | Netz kWh | PV kWh | Einspeisung kWh | Netz CHF | PV CHF | Ersparnis CHF | Mehrerlös CHF | PV Erlös CHF | Saldo CHF",
            new string('-', 120)
        };

        foreach (var row in rows)
        {
            tableLines.Add(
                $"{row.MonthLabel} | {row.PropertyName} | {row.TotalKwh:N3} | {row.GridKwh:N3} | {row.PvKwh:N3} | {row.FeedInKwh:N3} | {row.GridCost:N2} | {row.PvCost:N2} | {row.SavedByNeighborPv:N2} | {row.AdditionalRevenueVsFeedIn:N2} | {row.PvRevenue:N2} | {row.TotalCost:N2}");
        }

        var pages = SplitIntoPages(tableLines, 46);
        var pageCount = pages.Count;
        var fontObjectId = 3 + (pageCount * 2);
        var maxObjectId = fontObjectId;
        var objects = new Dictionary<int, byte[]>();

        objects[1] = Encoding.ASCII.GetBytes("<< /Type /Catalog /Pages 2 0 R >>");

        var kids = string.Join(' ', Enumerable.Range(0, pageCount).Select(i => $"{3 + (i * 2)} 0 R"));
        objects[2] = Encoding.ASCII.GetBytes($"<< /Type /Pages /Count {pageCount} /Kids [{kids}] >>");

        for (var i = 0; i < pageCount; i++)
        {
            var pageObjectId = 3 + (i * 2);
            var contentObjectId = pageObjectId + 1;

            objects[pageObjectId] = Encoding.ASCII.GetBytes($"<< /Type /Page /Parent 2 0 R /MediaBox [0 0 595 842] /Resources << /Font << /F1 {fontObjectId} 0 R >> >> /Contents {contentObjectId} 0 R >>");

            var streamText = BuildPdfTextStream(pages[i]);
            var streamBytes = Encoding.ASCII.GetBytes(streamText);
            var contentBuilder = new StringBuilder();
            contentBuilder.AppendLine($"<< /Length {streamBytes.Length} >>");
            contentBuilder.AppendLine("stream");
            contentBuilder.Append(streamText);
            contentBuilder.AppendLine();
            contentBuilder.Append("endstream");
            objects[contentObjectId] = Encoding.ASCII.GetBytes(contentBuilder.ToString());
        }

        objects[fontObjectId] = Encoding.ASCII.GetBytes("<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>");

        using var ms = new MemoryStream();
        using var writer = new StreamWriter(ms, Encoding.ASCII, leaveOpen: true);

        writer.WriteLine("%PDF-1.4");
        writer.Flush();

        var offsets = new long[maxObjectId + 1];
        for (var id = 1; id <= maxObjectId; id++)
        {
            offsets[id] = ms.Position;
            writer.WriteLine($"{id} 0 obj");
            writer.Flush();
            ms.Write(objects[id]);
            writer.WriteLine();
            writer.WriteLine("endobj");
            writer.Flush();
        }

        var startXref = ms.Position;
        writer.WriteLine("xref");
        writer.WriteLine($"0 {maxObjectId + 1}");
        writer.WriteLine("0000000000 65535 f ");
        for (var id = 1; id <= maxObjectId; id++)
        {
            writer.WriteLine($"{offsets[id]:D10} 00000 n ");
        }

        writer.WriteLine($"trailer << /Size {maxObjectId + 1} /Root 1 0 R >>");
        writer.WriteLine("startxref");
        writer.WriteLine(startXref.ToString(CultureInfo.InvariantCulture));
        writer.Write("%%EOF");
        writer.Flush();

        File.WriteAllBytes(filePath, ms.ToArray());
    }

    private static List<List<string>> SplitIntoPages(IReadOnlyList<string> lines, int pageSize)
    {
        var pages = new List<List<string>>();
        for (var i = 0; i < lines.Count; i += pageSize)
        {
            pages.Add(lines.Skip(i).Take(pageSize).ToList());
        }

        if (pages.Count == 0)
        {
            pages.Add([]);
        }

        return pages;
    }

    private static string BuildPdfTextStream(IEnumerable<string> lines)
    {
        var sb = new StringBuilder();
        sb.AppendLine("BT");
        sb.AppendLine("/F1 10 Tf");
        sb.AppendLine("40 800 Td");

        var first = true;
        foreach (var line in lines)
        {
            if (!first)
            {
                sb.AppendLine("0 -15 Td");
            }

            sb.AppendLine($"({EscapePdfText(line)}) Tj");
            first = false;
        }

        sb.AppendLine("ET");
        return sb.ToString();
    }

    private static string EscapePdfText(string text)
    {
        return text
            .Replace("\\", "\\\\", StringComparison.Ordinal)
            .Replace("(", "\\(", StringComparison.Ordinal)
            .Replace(")", "\\)", StringComparison.Ordinal);
    }

    private static List<MeterReading> ParseEbix(string filePath)
    {
        var document = XDocument.Load(filePath, LoadOptions.PreserveWhitespace);
        var result = new List<MeterReading>();
        var fallbackDate = TryExtractDateFromFilePath(filePath)?.ToDateTime(TimeOnly.MinValue)
            ?? File.GetLastWriteTime(filePath);

        var periodElements = document
            .Descendants()
            .Where(x => x.Name.LocalName.Contains("period", StringComparison.OrdinalIgnoreCase))
            .ToList();

        foreach (var period in periodElements)
        {
            var meterId = ExtractMeterId(period)
                ?? period.Ancestors().Select(ExtractMeterId).FirstOrDefault(x => !string.IsNullOrWhiteSpace(x));
            if (string.IsNullOrWhiteSpace(meterId))
            {
                continue;
            }

            var values = ExtractQuantities(period);
            if (values.Count == 0)
            {
                continue;
            }

            var date = ExtractDateTime(period)
                ?? period.Ancestors().Select(ExtractDateTime).FirstOrDefault(x => x.HasValue)
                ?? fallbackDate;

            result.Add(new MeterReading(meterId, date, values.Sum()));
        }

        if (result.Count == 0)
        {
            var text = File.ReadAllText(filePath);
            var meterIds = Regex.Matches(text, @"\bCH[0-9A-Z]{10,}\b", RegexOptions.IgnoreCase)
                .Select(x => x.Value)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();

            var numericValues = Regex.Matches(text, @"(?<![0-9])(\d+[\.,]\d+)(?![0-9])")
                .Select(x => ParseDecimalFlexible(x.Groups[1].Value))
                .Where(x => x.HasValue)
                .Select(x => x!.Value)
                .ToList();

            if (meterIds.Count > 0 && numericValues.Count > 0)
            {
                var kwh = numericValues.Sum();
                var date = fallbackDate;

                foreach (var meterId in meterIds)
                {
                    result.Add(new MeterReading(meterId, date, kwh));
                }
            }
        }

        return result
            .GroupBy(x => new { x.MeterId, x.PeriodStart })
            .Select(g => new MeterReading(g.Key.MeterId, g.Key.PeriodStart, g.Sum(x => x.Kwh)))
            .ToList();
    }

    private static DateOnly? TryExtractDateFromFilePath(string filePath)
    {
        var fileNameWithoutExtension = Path.GetFileNameWithoutExtension(filePath);
        if (TryExtractDateFromText(fileNameWithoutExtension, out var dateFromFileName))
        {
            return dateFromFileName;
        }

        var parentFolder = Path.GetFileName(Path.GetDirectoryName(filePath));
        if (TryExtractMonthFromText(parentFolder, out var dateFromFolder))
        {
            return dateFromFolder;
        }

        return null;
    }

    private static bool TryExtractDateFromText(string? text, out DateOnly date)
    {
        date = default;
        if (string.IsNullOrWhiteSpace(text))
        {
            return false;
        }

        var compactDateMatch = Regex.Match(text, @"^(?<y>20\d{2})(?<m>0[1-9]|1[0-2])(?<d>0[1-9]|[12]\d|3[01])(?:[_-].*)?$");
        if (compactDateMatch.Success)
        {
            return TryCreateDateOnly(compactDateMatch.Groups["y"].Value, compactDateMatch.Groups["m"].Value, compactDateMatch.Groups["d"].Value, out date);
        }

        var dashedDateMatch = Regex.Match(text, @"^(?<y>20\d{2})[-_](?<m>0[1-9]|1[0-2])[-_](?<d>0[1-9]|[12]\d|3[01])(?:[_-].*)?$");
        if (dashedDateMatch.Success)
        {
            return TryCreateDateOnly(dashedDateMatch.Groups["y"].Value, dashedDateMatch.Groups["m"].Value, dashedDateMatch.Groups["d"].Value, out date);
        }

        return false;
    }

    private static bool TryExtractMonthFromText(string? text, out DateOnly date)
    {
        date = default;
        if (string.IsNullOrWhiteSpace(text))
        {
            return false;
        }

        var monthMatch = Regex.Match(text, @"^(?<y>20\d{2})(?:-|_)?(?<m>0[1-9]|1[0-2])$");
        if (!monthMatch.Success)
        {
            return false;
        }

        if (!int.TryParse(monthMatch.Groups["y"].Value, out var year) || !int.TryParse(monthMatch.Groups["m"].Value, out var month))
        {
            return false;
        }

        date = new DateOnly(year, month, 1);
        return true;
    }

    private static bool TryCreateDateOnly(string yearText, string monthText, string dayText, out DateOnly date)
    {
        date = default;
        if (!int.TryParse(yearText, out var year)
            || !int.TryParse(monthText, out var month)
            || !int.TryParse(dayText, out var day))
        {
            return false;
        }

        try
        {
            date = new DateOnly(year, month, day);
            return true;
        }
        catch
        {
            return false;
        }
    }

    private static string? ExtractMeterId(XElement scope)
    {
        var candidateElements = scope.Descendants()
            .Where(x => x.Name.LocalName.Contains("mRID", StringComparison.OrdinalIgnoreCase)
                || x.Name.LocalName.Contains("Meter", StringComparison.OrdinalIgnoreCase)
                || x.Name.LocalName.Contains("Location", StringComparison.OrdinalIgnoreCase));

        foreach (var element in candidateElements)
        {
            var match = Regex.Match(element.Value, @"\bCH[0-9A-Z]{10,}\b", RegexOptions.IgnoreCase);
            if (match.Success)
            {
                return match.Value;
            }
        }

        var fallbackText = string.Join(' ', scope.Descendants().Select(x => x.Value));
        var fallbackMatch = Regex.Match(fallbackText, @"\bCH[0-9A-Z]{10,}\b", RegexOptions.IgnoreCase);
        return fallbackMatch.Success ? fallbackMatch.Value : null;
    }

    private static List<decimal> ExtractQuantities(XElement scope)
    {
        var quantities = new List<decimal>();

        foreach (var element in scope.Descendants())
        {
            var localName = element.Name.LocalName;
            var isLikelyQuantity = localName.Contains("quantity", StringComparison.OrdinalIgnoreCase)
                || localName.Contains("energy", StringComparison.OrdinalIgnoreCase)
                || localName.Equals("value", StringComparison.OrdinalIgnoreCase)
                || localName.EndsWith("qty", StringComparison.OrdinalIgnoreCase);

            if (!isLikelyQuantity)
            {
                continue;
            }

            var parsed = ParseDecimalFlexible(element.Value);
            if (parsed.HasValue)
            {
                quantities.Add(parsed.Value);
            }
        }

        if (quantities.Count > 0)
        {
            return quantities;
        }

        var fallbackMatches = Regex.Matches(scope.Value, @"(?<![0-9])(\d+[\.,]\d+)(?![0-9])");
        foreach (Match match in fallbackMatches)
        {
            var parsed = ParseDecimalFlexible(match.Groups[1].Value);
            if (parsed.HasValue)
            {
                quantities.Add(parsed.Value);
            }
        }

        return quantities;
    }

    private static DateTime? ExtractDateTime(XElement scope)
    {
        var dateCandidates = scope.Descendants()
            .Where(x => x.Name.LocalName.Contains("start", StringComparison.OrdinalIgnoreCase)
                || x.Name.LocalName.Contains("date", StringComparison.OrdinalIgnoreCase)
                || x.Name.LocalName.Contains("time", StringComparison.OrdinalIgnoreCase));

        foreach (var candidate in dateCandidates)
        {
            if (DateTime.TryParse(candidate.Value, CultureInfo.InvariantCulture, DateTimeStyles.AssumeUniversal, out var parsed)
                || DateTime.TryParse(candidate.Value, CultureInfo.GetCultureInfo("de-CH"), DateTimeStyles.AssumeLocal, out parsed))
            {
                return parsed;
            }
        }

        var textMatch = Regex.Match(scope.Value, @"\b(20\d{2}-\d{2}-\d{2})\b");
        if (textMatch.Success
            && DateOnly.TryParseExact(textMatch.Groups[1].Value, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date))
        {
            return date.ToDateTime(TimeOnly.MinValue);
        }

        return null;
    }

    private static decimal? ParseDecimalFlexible(string value)
    {
        var trimmed = value.Trim();
        if (decimal.TryParse(trimmed, NumberStyles.Any, CultureInfo.InvariantCulture, out var parsedInvariant))
        {
            return parsedInvariant;
        }

        var normalized = trimmed.Replace(',', '.');
        if (decimal.TryParse(normalized, NumberStyles.Any, CultureInfo.InvariantCulture, out var parsedNormalized))
        {
            return parsedNormalized;
        }

        return null;
    }

