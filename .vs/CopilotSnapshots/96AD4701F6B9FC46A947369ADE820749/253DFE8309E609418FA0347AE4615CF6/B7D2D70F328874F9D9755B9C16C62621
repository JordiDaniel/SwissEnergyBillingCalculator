    private void LoadFolderData(string folderPath, bool showMessages)
    {
        if (!Directory.Exists(folderPath))
        {
            LoadedFileText.Text = "Kein Ordner geladen";
            if (showMessages)
            {
                MessageBox.Show("Der konfigurierte Ordner wurde nicht gefunden.", "Hinweis", MessageBoxButton.OK, MessageBoxImage.Information);
            }

            return;
        }

        try
        {
            var folderValidation = ValidateDataFolderStructure(folderPath);
            var files = folderValidation.XmlFiles;

            if (files.Count == 0)
            {
                LoadedFileText.Text = "Keine XML-Dateien gefunden";
                if (showMessages)
                {
                    MessageBox.Show("Im gewählten Ordner wurden keine XML-Dateien gefunden.", "Hinweis", MessageBoxButton.OK, MessageBoxImage.Information);
                }

                return;
            }

            if (showMessages && folderValidation.Warnings.Count > 0)
            {
                var shownWarnings = folderValidation.Warnings.Take(6).ToList();
                var message = string.Join(Environment.NewLine, shownWarnings.Select(x => $"- {x}"));
                if (folderValidation.Warnings.Count > shownWarnings.Count)
                {
                    message += Environment.NewLine + $"- ... und {folderValidation.Warnings.Count - shownWarnings.Count} weitere Hinweise";
                }

                MessageBox.Show($"Ordnerstruktur-Hinweise:{Environment.NewLine}{message}", "Hinweis", MessageBoxButton.OK, MessageBoxImage.Information);
            }

            var parsedFileCount = 0;
            var failedFileCount = 0;
            var parsedReadings = new List<MeterReading>();

            foreach (var file in files)
            {
                try
                {
                    var fileReadings = ParseEbix(file);
                    if (fileReadings.Count == 0)
                    {
                        failedFileCount++;
                        continue;
                    }

                    parsedReadings.AddRange(fileReadings);
                    parsedFileCount++;
                }
                catch
                {
                    failedFileCount++;
                }
            }

            _meterReadings.Clear();
            _meterReadings.AddRange(parsedReadings);

            LoadedFileText.Text = $"Geladen: {parsedFileCount}/{files.Count} Dateien, {_meterReadings.Count} Werte";

            if (_meterReadings.Count == 0)
            {
                if (showMessages)
                {
                    MessageBox.Show("Es konnten keine verwertbaren EBIX-Werte erkannt werden.", "Hinweis", MessageBoxButton.OK, MessageBoxImage.Warning);
                }
            }
            else if (showMessages && failedFileCount > 0)
            {
                MessageBox.Show($"{failedFileCount} Datei(en) konnten nicht ausgewertet werden.", "Hinweis", MessageBoxButton.OK, MessageBoxImage.Information);
            }

            RefreshAvailableMeters();
            EnsureMonthlyPricesForData();
            AutoSaveConfiguration();
            RefreshMonthFilter();
            RefreshSummary();
        }
        catch (Exception ex)
        {
            LoadedFileText.Text = "Fehler beim Laden";
            if (showMessages)
            {
                MessageBox.Show($"Fehler beim Laden des EBIX-Ordners: {ex.Message}", "Fehler", MessageBoxButton.OK, MessageBoxImage.Error);
            }
        }
    }

